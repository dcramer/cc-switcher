<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cc-switcher</AssemblyName>
    <RootNamespace>CcSwitcher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <Version>0.1.0</Version>
    <Product>CC Switcher</Product>
    <Description>Unofficial profile launcher for Claude Desktop</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Dark mode (Application.SetColorMode) is still marked experimental in .NET 9. -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also as a resource: the icon Windows embeds in the exe can't be read back with all its sizes. -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
